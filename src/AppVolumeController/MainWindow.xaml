<Window x:Class="AppVolumeController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App Volume Controller" Icon="Assets/speaker.ico" Width="860" Height="850"
        MinWidth="640" MinHeight="500" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="WindowKeyDown" Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="4,4,12,4">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="App volume" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" Margin="0,0,28,6"/>
                    <Button x:Name="RefreshButton" Content="_Rescan" Click="RefreshClick" Margin="0,0,8,6"
                            AutomationProperties.Name="Rescan audio sessions" AutomationProperties.AcceleratorKey="F5" ToolTip="Find audio sessions now (F5)"/>
                    <Button x:Name="AppearanceButton" Content="_Appearance" Click="AppearanceClick" Margin="0,0,0,6"
                            AutomationProperties.Name="Appearance and accessibility" AutomationProperties.AcceleratorKey="Ctrl+," ToolTip="Themes, accent palettes, text size, and accessibility (Ctrl+,)"/>
                    <Button x:Name="HelpButton" Content="_Help" Click="HelpClick" Margin="8,0,0,6"
                            AutomationProperties.Name="Open user help" AutomationProperties.AcceleratorKey="F1" ToolTip="Open the offline user guide (F1)"/>
                </WrapPanel>
                <TextBlock Text="A comfortable balance for everything you play." Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,20"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Master output · Default playback device" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeviceName" Text="Finding your output device…" Foreground="{DynamicResource SecondaryBrush}" Margin="0,4,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Slider x:Name="MasterSlider" ValueChanged="MasterChanged" AutomationProperties.Name="Master output volume, percent"
                                    AutomationProperties.HelpText="Affects the default playback device. Arrow keys change by 1 percent; Page Up and Page Down by 10; Home and End go to 0 and 100."/>
                            <TextBlock x:Name="MasterValue" Grid.Column="1" Text="—" MinWidth="48" Margin="12,0" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <CheckBox x:Name="MasterMute" Grid.Column="2" Style="{StaticResource MuteToggle}" Click="MasterMuteClick" AutomationProperties.Name="Mute master output"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Applications" FontSize="{DynamicResource HeadingSize}" FontWeight="SemiBold" Margin="0,0,12,4"/>
                    <TextBlock x:Name="AppCount" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite"/>
                    <CheckBox x:Name="FavoritesOnly" Content="Favorites only" Click="FilterClick" Margin="16,-6,0,0"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource SecondaryText}" Text="Favorites appear first. Each slider controls all sessions for that app." Margin="0,2,0,10"/>
                <TextBlock x:Name="SearchLabel" Text="Find an app" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}"
                             AutomationProperties.AcceleratorKey="Ctrl+F" AutomationProperties.HelpText="Filter by application name. Escape clears the search."/>
                    <Button Grid.Column="1" Content="Clear" Click="ClearSearchClick" Margin="8,0,0,0" AutomationProperties.Name="Clear app search"/>
                </Grid>
                <ItemsControl x:Name="AppList" ItemsSource="{Binding VisibleRows}" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Top">
                                        <Grid><TextBlock Text="♫" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Width="28" Height="28"/></Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Grid.Column="1" Content="Favorite" IsChecked="{Binding Favorite}" VerticalAlignment="Top"
                                          AutomationProperties.Name="{Binding Name, StringFormat=Favorite {0}}" AutomationProperties.HelpText="Keep this application at the top of the list."/>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} volume, percent'}"
                                            AutomationProperties.HelpText="Arrow keys change by 1 percent; Page Up and Page Down by 10; Home and End go to 0 and 100. Changing volume keeps the current mute state."/>
                                    <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat={}{0}%}" MinWidth="48" Margin="12,0" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <CheckBox Grid.Column="2" Style="{StaticResource MuteToggle}" IsChecked="{Binding Muted}" AutomationProperties.Name="{Binding Name, StringFormat=Mute {0}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="Empty" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="EmptyTitle" Text="No audio sessions yet" FontSize="{DynamicResource HeadingSize}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EmptyDescription" Text="Play some audio in an app, then rescan. Apps will also appear automatically." Foreground="{DynamicResource SecondaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12">
                    <StackPanel>
                        <CheckBox x:Name="Remember" Click="RememberClick" AutomationProperties.Name="Remember my volume changes">
                            <TextBlock Text="Remember my volume changes"/>
                        </CheckBox>
                        <TextBlock Text="Restore the volume and mute settings you change here when apps create new audio sessions." Style="{StaticResource SecondaryText}" Margin="8,2,8,8"/>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource SecondaryText}" Text="Keyboard: Tab to move · Arrows to adjust · Space to toggle" Margin="0,20,0,4"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="4,12,12,0" Padding="0,12,0,0">
            <TextBlock x:Name="Status" Style="{StaticResource SecondaryText}" Text="Connecting to Windows audio…" AutomationProperties.LiveSetting="Polite"/>
        </Border>
    </Grid>
</Window>
