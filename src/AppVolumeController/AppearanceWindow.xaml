<Window x:Class="AppVolumeController.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Appearance &amp; accessibility" Icon="Assets/speaker.ico" Width="620" Height="820" MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="4,4,16,12">
            <StackPanel>
                <TextBlock Text="Make it yours" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold"/>
                <TextBlock Text="Preview changes here and in your mixer. Save when it feels right." Foreground="{DynamicResource SecondaryBrush}" Margin="0,8,0,20"/>
                <TextBlock Text="Theme" FontSize="{DynamicResource HeadingSize}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <WrapPanel x:Name="ThemeOptions" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Theme">
                    <RadioButton Content="System" Tag="System" GroupName="Theme" Checked="ThemeChecked" AutomationProperties.Name="Follow Windows theme"/>
                    <RadioButton Content="Light" Tag="Light" GroupName="Theme" Checked="ThemeChecked"/>
                    <RadioButton Content="Dark" Tag="Dark" GroupName="Theme" Checked="ThemeChecked"/>
                    <RadioButton Content="High contrast" Tag="High contrast" GroupName="Theme" Checked="ThemeChecked"/>
                </WrapPanel>
                <TextBlock x:Name="ContrastNotice" Style="{StaticResource SecondaryText}" Margin="0,2,0,20"/>
                <TextBlock Text="Accent palette" FontSize="{DynamicResource HeadingSize}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <WrapPanel x:Name="AccentOptions" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Accent palette">
                    <RadioButton Tag="Teal" GroupName="Accent" Checked="AccentChecked" AutomationProperties.Name="Teal accent">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{DynamicResource TealSwatchBrush}" Margin="0,0,7,0"/><TextBlock Text="Teal"/></StackPanel>
                    </RadioButton>
                    <RadioButton Tag="Blue" GroupName="Accent" Checked="AccentChecked" AutomationProperties.Name="Blue accent">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{DynamicResource BlueSwatchBrush}" Margin="0,0,7,0"/><TextBlock Text="Blue"/></StackPanel>
                    </RadioButton>
                    <RadioButton Tag="Violet" GroupName="Accent" Checked="AccentChecked" AutomationProperties.Name="Violet accent">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{DynamicResource VioletSwatchBrush}" Margin="0,0,7,0"/><TextBlock Text="Violet"/></StackPanel>
                    </RadioButton>
                    <RadioButton Tag="Amber" GroupName="Accent" Checked="AccentChecked" AutomationProperties.Name="Amber accent">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{DynamicResource AmberSwatchBrush}" Margin="0,0,7,0"/><TextBlock Text="Amber"/></StackPanel>
                    </RadioButton>
                    <RadioButton Content="Custom" Tag="Custom" GroupName="Accent" Checked="AccentChecked"/>
                </WrapPanel>
                <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,4,0,12">
                    <TextBlock x:Name="HexLabel" Text="Custom accent (#RRGGBB)" Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True">
                        <Button Content="Apply color" DockPanel.Dock="Right" Click="ApplyColorClick" Margin="8,0,0,0"/>
                        <TextBox x:Name="HexInput" MaxLength="7" TextChanged="HexChanged" AutomationProperties.LabeledBy="{Binding ElementName=HexLabel}" AutomationProperties.HelpText="Enter a hash followed by six hexadecimal digits, for example #14B8A6."/>
                    </DockPanel>
                </StackPanel>
                <TextBlock x:Name="ColorFeedback" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock Text="Palette preview" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PaletteSummary" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,8"/>
                        <Slider Value="65" AutomationProperties.Name="Preview volume, percent" AutomationProperties.HelpText="Appearance preview only. This slider does not change audio."/>
                        <TextBlock Text="Accents are adjusted for readable text and visible controls." Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Text size" FontSize="{DynamicResource HeadingSize}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <WrapPanel x:Name="ScaleOptions" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Text size">
                    <RadioButton Content="100%" Tag="1" GroupName="Scale" Checked="ScaleChecked"/>
                    <RadioButton Content="125%" Tag="1.25" GroupName="Scale" Checked="ScaleChecked"/>
                    <RadioButton Content="150%" Tag="1.5" GroupName="Scale" Checked="ScaleChecked"/>
                    <RadioButton Content="200%" Tag="2" GroupName="Scale" Checked="ScaleChecked"/>
                </WrapPanel>
                <TextBlock Text="Windows display scaling is also supported. Content scrolls as text grows." Style="{StaticResource SecondaryText}" Margin="0,0,0,20"/>
                <TextBlock Text="Keyboard &amp; assistive technology" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Tab / Shift+Tab: move between controls&#10;Arrow keys: adjust volume or select an option&#10;Page Up / Down: adjust volume by 10%&#10;Home / End: set volume to 0% / 100%&#10;Space: toggle mute or favorite&#10;Ctrl+F: find an app · F5: rescan&#10;Ctrl+,: open these settings · Esc: cancel" Style="{StaticResource SecondaryText}"/>
                <TextBlock Text="Controls have screen-reader labels, visible keyboard focus, and text cues as well as color. No interface animations are used." Style="{StaticResource SecondaryText}" Margin="0,12,0,16"/>
                <Button Content="Reset appearance" HorizontalAlignment="Left" Click="ResetClick" ToolTip="Preview the default theme, palette, and text size. Save to keep the reset."/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="SaveFeedback" Margin="4,8" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="_Cancel" IsCancel="True" Click="CancelClick" Margin="0,0,8,4"/>
                <Button x:Name="SaveButton" Content="_Save changes" Click="SaveClick" Margin="0,0,0,4" BorderBrush="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
